Options -MultiViews
RewriteEngine On
RewriteBase /

# 1. Trang ch? m?c d?nh
DirectoryIndex index.php

# ==========================================
# B?NG �?A CH? (d� m� ho�, t�n trang b?ng ti?ng Anh)
#   Home            /asadnsrdecsb/home
#   Login           /lazrlshalvow/login
#   Register        /ddbyevhmtepm/register
#   Free key        /hkvpnmzyqfhw/key-free
#   Shop            /zwpxnupvcnsk/shop
#   Get free key    /gtjsdzxhflhv/get-free
#   Maintenance     /lwhhrrrjuaoo/maintenance
#   Admin panel     /vfjhdizchmgr/admin
#   C�c trang kh�c  /egoyesfdemnt/ten-trang
# Mu?n d?i do?n m� n�o th� Find/Replace do?n d� trong file n�y (d?i ? m?i ch?).
# ==========================================

# ==========================================
# PH?N A: CHUY?N HU?NG B?T BU?C (External Redirect)
# Link ngu?i d�ng nh�n th?y / sao ch�p lu�n l� d?ng /ma-hoa/ten-trang,
# kh�ng bao gi? hi?n ch? "index" hay du�i ".php".
# Ch? �p d?ng khi m? trang (GET/HEAD). Form g?i POST kh�ng b? chuy?n hu?ng n�n kh�ng b? l?i.
# ==========================================

# Trang ch?  /  ->  /asadnsrdecsb/home   (302 d? d? d?i �, ?n r?i th� d?i th�nh 301)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^$ /asadnsrdecsb/home [R=302,L]

# ?n index / index.php (? g?c ho?c trong c�c d?a ch? m� ho�) -> trang ch? m� ho�
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?index(?:\.php|\.html?)?/?[\s?] [NC]
RewriteRule ^(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?index(?:\.php|\.html?)?/?$ /asadnsrdecsb/home [R=302,L,NC]

# [FIX G?T] B?t c?c nh?y m?i d?u v?t get_key t? request ban d?u
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/gtjsdzxhflhv/
RewriteCond %{THE_REQUEST} \s/(.*)?get_key [NC]
RewriteRule ^ /gtjsdzxhflhv/get-free [R=302,L,NE]

# login.php -> /lazrlshalvow/login
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?login\.php[\s?] [NC]
RewriteRule ^(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?login\.php$ /lazrlshalvow/login [R=302,L,NC]

# register.php -> /ddbyevhmtepm/register
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?register\.php[\s?] [NC]
RewriteRule ^(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?register\.php$ /ddbyevhmtepm/register [R=302,L,NC]

# key.php -> /hkvpnmzyqfhw/key-free
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?key\.php[\s?] [NC]
RewriteRule ^(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?key\.php$ /hkvpnmzyqfhw/key-free [R=302,L,NC]

# shop.php -> /zwpxnupvcnsk/shop
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?shop\.php[\s?] [NC]
RewriteRule ^(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?shop\.php$ /zwpxnupvcnsk/shop [R=302,L,NC]

# check_maintenance.php -> /lwhhrrrjuaoo/maintenance
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?check_maintenance\.php[\s?] [NC]
RewriteRule ^(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?check_maintenance\.php$ /lwhhrrrjuaoo/maintenance [R=302,L,NC]

# admin_cp.php (ho?c thu m?c admin_cp) -> /vfjhdizchmgr/admin
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?admin_cp(?:\.php)?/?[\s?] [NC]
RewriteRule ^(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?admin_cp(?:\.php)?/?$ /vfjhdizchmgr/admin [R=302,L,NC]

# �?a ch? cu -> d?a ch? m� ho�
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^(?:dang-nhap|login)/?$ /lazrlshalvow/login [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^(?:dang-ky|register)/?$ /ddbyevhmtepm/register [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^key-free/?$ /hkvpnmzyqfhw/key-free [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^shop/?$ /zwpxnupvcnsk/shop [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^get-free/?$ /gtjsdzxhflhv/get-free [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^(?:menu|home)/?$ /asadnsrdecsb/home [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^(?:baotri|maintenance)/?$ /lwhhrrrjuaoo/maintenance [R=302,L,NC]

# �?a ch? /member/... c?a c�c b?n th? tru?c (tr�nh duy?t c� th? c�n nh?) -> d?a ch? m� ho�
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/?$ /asadnsrdecsb/home [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/(?:home|menu|index)(?:\.php)?/?$ /asadnsrdecsb/home [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/(?:dang-nhap|login)(?:\.php)?/?$ /lazrlshalvow/login [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/(?:dang-ky|register)(?:\.php)?/?$ /ddbyevhmtepm/register [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/(?:key-free|key)(?:\.php)?/?$ /hkvpnmzyqfhw/key-free [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/shop(?:\.php)?/?$ /zwpxnupvcnsk/shop [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/(?:get-free|get_key)(?:\.php)?/?$ /gtjsdzxhflhv/get-free [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/(?:admin|admin_cp)(?:\.php)?/?$ /vfjhdizchmgr/admin [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/(?:baotri|maintenance|check_maintenance)(?:\.php)?/?$ /lwhhrrrjuaoo/maintenance [R=302,L,NC]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^member/(.+?)(?:\.php)?/?$ /egoyesfdemnt/$1 [R=302,L,NC]

# M?i trang .php c�n l?i (hi?n t?i v� sau n�y) -> /egoyesfdemnt/ten-trang
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?[^/\s?#]+\.php[\s?] [NC]
RewriteRule ^(?:(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/)?([^/]+)\.php$ /egoyesfdemnt/$1 [R=302,L]

# Thu m?c con: b? ch? index / index.php ? cu?i du?ng d?n (vd /abc/index.php -> /abc/)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/(.+/)index(?:\.php|\.html?)?[\s?] [NC]
RewriteRule ^(.+/)index(?:\.php|\.html?)?$ /$1 [R=302,L]

# ==========================================
# PH?N B: �?C D? LI?U T? FILE ?N (Internal Rewrite)
# ==========================================

# ICON TAB: tr? logo C?A B?N cho /favicon.ico (d?i logo.png th�nh t�n file logo c?a b?n).
# N?u file kh�ng t?n t?i th� b? qua, kh�ng g�y l?i.
RewriteCond %{DOCUMENT_ROOT}/logo.png -f
RewriteRule ^favicon\.ico$ logo.png [NC,L]

# --- C�c trang ch�nh ---
RewriteRule ^asadnsrdecsb/home/?$ index.php [NC,L]
RewriteRule ^lazrlshalvow/login/?$ login.php [NC,L]
RewriteRule ^ddbyevhmtepm/register/?$ register.php [NC,L]
RewriteRule ^hkvpnmzyqfhw/key-free/?$ key.php [NC,L]
RewriteRule ^zwpxnupvcnsk/shop/?$ shop.php [NC,L]
RewriteRule ^gtjsdzxhflhv/get-free/[^/]+/(go|verify)/?$ get_key.php?a=$1 [NC,L,QSA]
RewriteRule ^gtjsdzxhflhv/get-free/[^/]+/?$ get_key.php [NC,L,QSA]
RewriteRule ^gtjsdzxhflhv/get-free/?$ get_key.php [NC,L]
RewriteRule ^hkvpnmzyqfhw/key-free/[^/]+/?$ key.php [NC,L,QSA]
RewriteRule ^lwhhrrrjuaoo/maintenance/?$ check_maintenance.php [NC,L]

# --- Admin: file admin_cp.php ho?c thu m?c admin_cp ---
RewriteCond %{DOCUMENT_ROOT}/admin_cp.php -f
RewriteRule ^vfjhdizchmgr/admin/?$ admin_cp.php [NC,L]

RewriteCond %{DOCUMENT_ROOT}/admin_cp -d
RewriteRule ^vfjhdizchmgr/admin/?$ admin_cp/ [NC,L]

RewriteCond %{DOCUMENT_ROOT}/admin_cp/$1 -f
RewriteRule ^vfjhdizchmgr/admin/(.+)$ admin_cp/$1 [NC,L]

# --- Trang kh�c: /egoyesfdemnt/ten-trang t? t�m file .php ho?c thu m?c th?t ---
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^egoyesfdemnt/(.+?)/?$ $1.php [NC,L]

RewriteCond %{DOCUMENT_ROOT}/$1 -d
RewriteRule ^egoyesfdemnt/(.+?)/?$ $1/ [NC,L]

# --- ?nh, CSS, JS, link tuong d?i b�n du?i m?i d?a ch? m� ho� t? t�m file th?t ? thu m?c g?c ---
# (v� d? /asadnsrdecsb/assets/a.css -> assets/a.css; form POST t?i admin_cp.php... v?n ch?y)
RewriteCond %{DOCUMENT_ROOT}/$1 -f
RewriteRule ^(?:asadnsrdecsb|lazrlshalvow|ddbyevhmtepm|hkvpnmzyqfhw|zwpxnupvcnsk|gtjsdzxhflhv|lwhhrrrjuaoo|vfjhdizchmgr|egoyesfdemnt)/(.+)$ $1 [NC,L]

# --- �?a ch? cu, gi? nguy�n d? form POST t?i d?a ch? cu v?n ch?y ---
RewriteRule ^dang-nhap/?$ login.php [NC,L]
RewriteRule ^dang-ky/?$ register.php [NC,L]
RewriteRule ^key-free/?$ key.php [NC,L]
RewriteRule ^shop/?$ shop.php [NC,L]
RewriteRule ^get-free/?$ get_key.php [NC,L]

# [�� FIX] S?a l?i ng?t d�ng ? menu
RewriteRule ^menu/?$ index.php [NC,L]

# T? d?ng ?n du�i .php cho c�c file ph�t sinh sau n�y
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]
# dsx-hash-v1 BEGIN
